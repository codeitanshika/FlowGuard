# --- Anthropic (used starting Phase 8/9 — Healer/Fraud agents) ---
ANTHROPIC_API_KEY=

# --- Payment provider sandbox (used starting Phase 10) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Shared infrastructure ---
REDIS_URL=redis://localhost:6379/0

# --- User Service (port 8003) ---
USER_DATABASE_URL=postgresql+asyncpg://flowguard:flowguard@localhost:5432/flowguard_user

# --- Payment Service (port 8001) ---
PAYMENT_DATABASE_URL=postgresql+asyncpg://flowguard:flowguard@localhost:5432/flowguard_payment
PAYMENT_FRAUD_SERVICE_URL=http://localhost:8002
PAYMENT_USER_SERVICE_URL=http://localhost:8003

# --- Fraud Service (port 8002) ---
FRAUD_DATABASE_URL=postgresql+asyncpg://flowguard:flowguard@localhost:5432/flowguard_fraud

# --- Notification Service (port 8004) ---
NOTIFICATION_DATABASE_URL=postgresql+asyncpg://flowguard:flowguard@localhost:5432/flowguard_notification

# --- API Gateway (port 8000) ---
GATEWAY_PAYMENT_SERVICE_URL=http://localhost:8001
GATEWAY_USER_SERVICE_URL=http://localhost:8003
GATEWAY_NOTIFICATION_SERVICE_URL=http://localhost:8004

# --- API Gateway security (Phase 2) ---
# Generate your own for any environment that isn't a throwaway local
# sandbox: python -c "import secrets; print(secrets.token_urlsafe(48))"
GATEWAY_JWT_SECRET=change-me-in-every-real-environment
GATEWAY_JWT_EXPIRES_IN=3600
GATEWAY_RATE_LIMIT_PER_MINUTE=100
GATEWAY_LOGIN_RATE_LIMIT_PER_MINUTE=10

# Two local-dev-only test clients (plaintext secrets below, for your own
# testing — never commit real credentials in any non-throwaway
# environment). "test-merchant" has every scope; "readonly-client" only
# read scopes, for exercising a 403.
#   test-merchant / test-secret-123
#   readonly-client / readonly-secret-123
GATEWAY_CLIENTS={"test-merchant":{"secret_hash":"$2b$12$Rjanc7SSPgUoUIs5x5VtjOATONnBafei1e9q3npfe3fxk79PAIvfy","scopes":["payments:read","payments:write","users:read","users:write","notifications:read"]},"readonly-client":{"secret_hash":"$2b$12$loqBFuuDkVw.O4AUcDPVtOfOFLPLFLkyEv4Y/pDwONe/CKQNb4Ldm","scopes":["payments:read","users:read","notifications:read"]}}
