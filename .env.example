# --- Anthropic (Healer Agent from Phase 8, Fraud Agent from Phase 9) ---
# Optional: with no key the Healer still works, deciding from its
# deterministic rules only (logs healer.llm_disabled at startup).
ANTHROPIC_API_KEY=

# --- Payment provider sandbox (used starting Phase 10) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Shared infrastructure ---
REDIS_URL=redis://localhost:6379/0
# Standard OTel SDK env var (not FlowGuard-specific) — every service
# reads this directly, not through its own Settings class. Points at
# Jaeger's OTLP/HTTP receiver; docker-compose.yml overrides this to
# http://jaeger:4318 the same way it overrides the *_DATABASE_URL vars.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- User Service (port 8003) ---
USER_DATABASE_URL=postgresql+asyncpg://flowguard:flowguard@localhost:5432/flowguard_user

# --- Payment Service (port 8001) ---
PAYMENT_DATABASE_URL=postgresql+asyncpg://flowguard:flowguard@localhost:5432/flowguard_payment
PAYMENT_FRAUD_SERVICE_URL=http://localhost:8002
PAYMENT_USER_SERVICE_URL=http://localhost:8003

# --- Fraud Service (port 8002) ---
FRAUD_DATABASE_URL=postgresql+asyncpg://flowguard:flowguard@localhost:5432/flowguard_fraud

# --- Notification Service (port 8004) ---
NOTIFICATION_DATABASE_URL=postgresql+asyncpg://flowguard:flowguard@localhost:5432/flowguard_notification

# --- Monitor Agent (port 8005, Phase 7) ---
MONITOR_DATABASE_URL=postgresql+asyncpg://flowguard:flowguard@localhost:5432/flowguard_control
MONITOR_JAEGER_QUERY_URL=http://localhost:16686
# Optional tuning (defaults shown in agents/monitor/config.py), e.g.:
# MONITOR_POLL_INTERVAL_SECONDS=15
# MONITOR_WINDOW_SECONDS=60
# MONITOR_ALERT_COOLDOWN_SECONDS=120
# MONITOR_SERVICE_THRESHOLDS={"payment":{"p95_warning_ms":500}}

# --- Ops Controller (port 8006) and Healer Agent (port 8007), Phase 8 ---
# Shared secret: the Ops Controller only accepts calls bearing it, and the
# Healer is the only holder. Local-dev value — generate your own anywhere
# else: python -c "import secrets; print(secrets.token_urlsafe(32))"
OPS_HEALER_TOKEN=local-dev-healer-token-change-me
OPS_DATABASE_URL=postgresql+asyncpg://flowguard:flowguard@localhost:5432/flowguard_control
OPS_PAYMENT_SERVICE_URL=http://localhost:8001
HEALER_DATABASE_URL=postgresql+asyncpg://flowguard:flowguard@localhost:5432/flowguard_control
HEALER_OPS_CONTROLLER_URL=http://localhost:8006
HEALER_JAEGER_QUERY_URL=http://localhost:16686
# Optional tuning: HEALER_LLM_MODEL (default claude-opus-5),
# HEALER_VERIFY_TIMEOUT_SECONDS (300), OPS_ACTION_COOLDOWN_SECONDS (60)

# --- API Gateway (port 8000) ---
GATEWAY_PAYMENT_SERVICE_URL=http://localhost:8001
GATEWAY_USER_SERVICE_URL=http://localhost:8003
GATEWAY_NOTIFICATION_SERVICE_URL=http://localhost:8004
# Not in the proxy route table (Fraud is never called by clients
# directly) — used only by the Phase 6 debug endpoint to forward
# fault-injection control calls to Fraud's /internal/fault-injection.
GATEWAY_FRAUD_SERVICE_URL=http://localhost:8002

# --- API Gateway security (Phase 2) ---
# Generate your own for any environment that isn't a throwaway local
# sandbox: python -c "import secrets; print(secrets.token_urlsafe(48))"
GATEWAY_JWT_SECRET=change-me-in-every-real-environment
GATEWAY_JWT_EXPIRES_IN=3600
GATEWAY_RATE_LIMIT_PER_MINUTE=100
GATEWAY_LOGIN_RATE_LIMIT_PER_MINUTE=10

# Two local-dev-only test clients (plaintext secrets below, for your own
# testing — never commit real credentials in any non-throwaway
# environment). "test-merchant" has every scope; "readonly-client" only
# read scopes, for exercising a 403.
#   test-merchant / test-secret-123
#   readonly-client / readonly-secret-123
#
# test-merchant also carries debug:write (Phase 6 fault-injection
# control) — readonly-client deliberately doesn't, so it can still be
# used to exercise a 403 there too.
#
# NOTE for docker-compose.yml specifically: Compose interpolates $VAR in
# every value it reads, including ones sourced from this file via
# env_file — the bcrypt hashes below (format $2b$12$...) get mangled by
# that if read through env_file directly. docker-compose.yml's gateway
# service carries its own $$-escaped override of this exact value for
# that reason (see the comment there) — this line here is what
# host-based dev (pydantic-settings, no interpolation) actually reads,
# and is the source of truth if you regenerate these credentials; keep
# both in sync by hand.
GATEWAY_CLIENTS={"test-merchant":{"secret_hash":"$2b$12$Rjanc7SSPgUoUIs5x5VtjOATONnBafei1e9q3npfe3fxk79PAIvfy","scopes":["payments:read","payments:write","users:read","users:write","notifications:read","debug:write"]},"readonly-client":{"secret_hash":"$2b$12$loqBFuuDkVw.O4AUcDPVtOfOFLPLFLkyEv4Y/pDwONe/CKQNb4Ldm","scopes":["payments:read","users:read","notifications:read"]}}
